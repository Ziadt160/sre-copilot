# Copy to .env and fill in. .env is gitignored; never commit real keys.
SRE_ENV=lab

# Lab: the local Supabase stack (npx supabase start prints these).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model providers (optional: without keys, dev and CI use local Ollama).
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Observability.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sre-copilot

# Embeddings: load HF models from the local cache only.
HF_OFFLINE=false

# Integration tests: admin DSN of a shared test Postgres (else testcontainers starts one).
# SRE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54400/postgres
